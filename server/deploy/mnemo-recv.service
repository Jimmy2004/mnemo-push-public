[Unit]
Description=Mnemosyne push receiver
After=network.target

[Service]
User=mnemo
Group=mnemo
ExecStart=/usr/bin/python3 -I /usr/local/lib/mnemo_recv.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/mnemo-recv

[Install]
WantedBy=multi-user.target
